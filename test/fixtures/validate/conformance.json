[
  { "name": "type", "schema": { "type": "integer" }, "doc": "7", "expect": ["DF_SCHEMA_TYPE"] },
  { "name": "type union", "schema": { "type": ["string", "null"] }, "doc": 7, "expect": ["DF_SCHEMA_TYPE"] },
  { "name": "required", "schema": { "type": "object", "required": ["id", "label"] }, "doc": { "id": "a" }, "expect": ["DF_SCHEMA_REQUIRED"], "paths": ["$.label"] },
  { "name": "enum", "schema": { "enum": ["public", "private"] }, "doc": "secret", "expect": ["DF_SCHEMA_ENUM"] },
  { "name": "const", "schema": { "const": "dotfield.scene/1" }, "doc": "dotfield.scene/2", "expect": ["DF_SCHEMA_CONST"] },
  { "name": "unknown field", "schema": { "type": "object", "properties": { "id": {} }, "additionalProperties": false }, "doc": { "id": 1, "idd": 2 }, "expect": ["DF_SCHEMA_UNKNOWN_FIELD"], "paths": ["$.idd"] },
  { "name": "not allowed", "schema": { "type": "object", "properties": { "projected": false } }, "doc": { "projected": {} }, "expect": ["DF_SCHEMA_NOT_ALLOWED"], "paths": ["$.projected"] },
  { "name": "pattern", "schema": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.:-]{0,79}$" }, "doc": "Not An Id", "expect": ["DF_SCHEMA_PATTERN"] },
  { "name": "min length", "schema": { "type": "string", "minLength": 1 }, "doc": "", "expect": ["DF_SCHEMA_MIN_LENGTH"] },
  { "name": "max length", "schema": { "type": "string", "maxLength": 3 }, "doc": "abcd", "expect": ["DF_SCHEMA_MAX_LENGTH"] },
  { "name": "min items", "schema": { "type": "array", "minItems": 3 }, "doc": [1, 2], "expect": ["DF_SCHEMA_MIN_ITEMS"] },
  { "name": "max items", "schema": { "type": "array", "maxItems": 1 }, "doc": [1, 2], "expect": ["DF_SCHEMA_MAX_ITEMS"] },
  { "name": "max properties", "schema": { "type": "object", "maxProperties": 1 }, "doc": { "a": 1, "b": 2 }, "expect": ["DF_SCHEMA_MAX_PROPERTIES"] },
  { "name": "minimum", "schema": { "type": "number", "minimum": 0 }, "doc": -0.5, "expect": ["DF_SCHEMA_MINIMUM"] },
  { "name": "maximum", "schema": { "type": "number", "maximum": 1 }, "doc": 1.5, "expect": ["DF_SCHEMA_MAXIMUM"] },
  { "name": "one of none", "schema": { "oneOf": [{ "type": "null" }, { "type": "string" }] }, "doc": 5, "expect": ["DF_SCHEMA_ONE_OF"] },
  { "name": "one of several", "schema": { "oneOf": [{ "type": "number" }, { "minimum": 0 }] }, "doc": 5, "expect": ["DF_SCHEMA_ONE_OF"] },
  { "name": "format date", "schema": { "type": "string", "format": "date" }, "doc": "2021-02-29", "expect": ["DF_SCHEMA_FORMAT"] },
  { "name": "format date-time", "schema": { "type": "string", "format": "date-time" }, "doc": "2026-10-01 10:15:00", "expect": ["DF_SCHEMA_FORMAT"] },
  { "name": "ref unresolved", "schema": { "properties": { "a": { "$ref": "#/$defs/missing" } }, "$defs": {} }, "doc": { "a": 1 }, "expect": ["DF_SCHEMA_REF_UNRESOLVED"] },
  { "name": "unsupported keyword", "schema": { "allOf": [{ "type": "string" }] }, "doc": "x", "expect": ["DF_SCHEMA_UNSUPPORTED_KEYWORD"] },
  { "name": "unsupported format", "schema": { "type": "string", "format": "email" }, "doc": "x", "expect": ["DF_SCHEMA_UNSUPPORTED_KEYWORD"] },
  { "name": "unsupported external ref", "schema": { "$ref": "https://json-schema.org/draft/2020-12/schema" }, "doc": {}, "expect": ["DF_SCHEMA_UNSUPPORTED_KEYWORD"] },
  { "name": "invalid schema regex", "schema": { "type": "string", "pattern": "([" }, "doc": "x", "expect": ["DF_SCHEMA_INVALID_SCHEMA"] },
  { "name": "invalid schema shape", "schema": { "properties": { "a": 5 } }, "doc": { "a": 1 }, "expect": ["DF_SCHEMA_INVALID_SCHEMA"] },
  { "name": "circular ref", "schema": { "$ref": "#" }, "doc": 1, "expect": ["DF_SCHEMA_INVALID_SCHEMA"] },
  { "name": "nested path", "schema": { "type": "object", "properties": { "nodes": { "type": "array", "items": { "type": "object", "properties": { "weight": { "type": "number", "maximum": 1 } } } } } }, "doc": { "nodes": [{ "weight": 0.5 }, { "weight": 2 }] }, "expect": ["DF_SCHEMA_MAXIMUM"], "paths": ["$.nodes[1].weight"] },
  { "name": "valid document", "schema": { "type": "object", "required": ["id"], "properties": { "id": { "type": "string" } }, "additionalProperties": false }, "doc": { "id": "ok" }, "expect": [] },
  { "name": "recursive oneOf, valid list of depth 3", "schema": { "oneOf": [{ "type": "null" }, { "type": "object", "additionalProperties": false, "required": ["next"], "properties": { "next": { "$ref": "#" } } }] }, "doc": { "next": { "next": { "next": null } } }, "expect": [] },
  { "name": "recursive oneOf, bad leaf", "schema": { "oneOf": [{ "type": "null" }, { "type": "object", "additionalProperties": false, "required": ["next"], "properties": { "next": { "$ref": "#" } } }] }, "doc": { "next": { "next": { "next": 5 } } }, "expect": ["DF_SCHEMA_ONE_OF"], "paths": ["$"] }
]
