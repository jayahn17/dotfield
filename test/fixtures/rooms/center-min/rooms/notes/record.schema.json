{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Note",
  "type": "object",
  "additionalProperties": false,
  "required": ["note_id", "title", "logged_on"],
  "properties": {
    "note_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.:-]{0,79}$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "body": { "type": "string", "maxLength": 4000 },
    "tags": { "type": "array", "maxItems": 16, "items": { "type": "string", "minLength": 1, "maxLength": 40 } },
    "links": { "type": "array", "maxItems": 32, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.:-]{0,79}$" } },
    "happened_on": { "type": "string", "format": "date" },
    "logged_on": { "type": "string", "format": "date" },
    "score": { "type": "number", "minimum": 0, "maximum": 10 }
  }
}
