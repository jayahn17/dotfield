{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Follow-up",
  "type": "object",
  "additionalProperties": false,
  "required": ["followup_id", "case_id", "kind", "due_on", "status", "logged_on"],
  "properties": {
    "followup_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.:-]{0,79}$" },
    "case_id": { "type": "string", "pattern": "^case-[0-9a-f]{6}$" },
    "kind": { "enum": ["review", "test", "call", "referral"] },
    "due_on": { "type": "string", "format": "date" },
    "status": { "enum": ["due", "done", "missed"] },
    "protocol_step": { "type": "integer", "minimum": 1, "maximum": 200 },
    "logged_on": { "type": "string", "format": "date" },
    "tags": { "type": "array", "maxItems": 8, "items": { "type": "string", "minLength": 1, "maxLength": 40 } }
  }
}
