{
  "schema_version": "dotfield.room/1",
  "id": "experiments",
  "label": "Experiments",
  "icon": "flask",
  "pack": "research-lab",
  "purpose": "One hypothesis, one dataset, one outcome: the measurements that test the papers, in the order they were run.",
  "mode": "proposal_only",
  "privacy_mode": "synthetic_data",
  "maturity": "contract_only",
  "store": { "scope": "owner", "namespace": "experiments", "max_records": 2000, "max_record_bytes": 16384 },
  "record": {
    "schema": "record.schema.json",
    "id_field": "exp_id",
    "label_field": "title",
    "sublabel_field": "outcome",
    "tag_field": "tags",
    "weight_field": "confidence",
    "dates": { "happened_on": "run_on", "remembered_on": "logged_on" },
    "link_fields": [ { "field": "dataset_id", "to_room": "datasets", "kind": "depends" }, { "field": "paper_ids", "to_room": "papers", "kind": "cites" } ],
    "default_privacy_level": "private",
    "public_fields": ["title", "metric", "value", "run_on", "tags"]
  },
  "views": "views.json",
  "desks": [
    {
      "id": "methods", "display": "Methods", "tier": "challenger", "domain": "research methods",
      "primary_field": "experimental design", "adjacent_fields": ["statistics", "metrology"],
      "lens": "a result without its power analysis and its confound list is an anecdote",
      "keywords": ["method", "power-analysis", "confound", "effect-size", "replication", "control"],
      "challenger_for": ["lit-review", "grants"], "influences": ["data-desk"],
      "constraint": "never reports a number without a record id as evidence and a stated uncertainty",
      "prompt": null
    }
  ],
  "owner_gates": { "writes": "required", "external_sends": "blocked", "share": "required", "aggregate": "blocked", "train": "blocked" },
  "blocked_actions": ["send_email", "submit_manuscript", "upload_dataset"],
  "proof": {
    "test": false,
    "expected": ["examples.json validates", "timeline view orders runs by run_on with one event per record", "a proposal never changes data/rooms/experiments.json"]
  },
  "done_definition": "Done as prototype when dotfield prove experiments exits 0 and the timeline renders with no DF_IR_* or DF_LAYOUT_* failure; contract_only until then."
}
