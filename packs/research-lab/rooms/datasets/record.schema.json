{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dataset",
  "type": "object",
  "additionalProperties": false,
  "required": ["dataset_id", "name", "modality", "logged_on"],
  "properties": {
    "dataset_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.:-]{0,79}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "modality": { "type": "string", "minLength": 1, "maxLength": 40 },
    "n_subjects": { "type": "integer", "minimum": 0 },
    "license": { "type": "string", "maxLength": 60 },
    "path_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "tags": { "type": "array", "maxItems": 16, "items": { "type": "string", "minLength": 1, "maxLength": 40 } },
    "collected_on": { "type": "string", "format": "date" },
    "logged_on": { "type": "string", "format": "date" }
  }
}
