{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dotfield.record-meta/1",
  "title": "Dotfield record meta-schema",
  "description": "The shape every center/rooms/<id>/record.schema.json must have: one closed object schema (type object, additionalProperties false) whose properties are the record fields, written inside the validator keyword subset (lib/validate.mjs). Nesting is bounded: a field may hold an array of items or an object of items; an item may hold scalars. lib/rooms.mjs then checks that every field the manifest names is declared here (DF_ROOM_FIELD_MISSING).",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "properties", "additionalProperties"],
  "properties": {
    "$schema": { "type": "string", "maxLength": 200 },
    "$id": { "type": "string", "pattern": "^[A-Za-z0-9._:/-]{1,120}$" },
    "title": { "type": "string", "maxLength": 120 },
    "description": { "type": "string", "maxLength": 1000 },
    "$comment": { "type": "string", "maxLength": 1000 },
    "type": { "const": "object" },
    "additionalProperties": { "const": false },
    "maxProperties": { "type": "integer", "minimum": 1, "maximum": 64 },
    "required": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/field_name" } },
    "properties": {
      "type": "object",
      "maxProperties": 64,
      "additionalProperties": false,
      "patternProperties": { "^[a-z][a-z0-9_]{0,63}$": { "$ref": "#/$defs/field" } }
    },
    "$defs": {
      "type": "object",
      "maxProperties": 32,
      "additionalProperties": false,
      "patternProperties": { "^[A-Za-z][A-Za-z0-9_]{0,63}$": { "$ref": "#/$defs/field" } }
    }
  },
  "$defs": {
    "field_name": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
    "type_name": { "enum": ["string", "number", "integer", "boolean", "object", "array", "null"] },
    "type_spec": { "oneOf": [ { "$ref": "#/$defs/type_name" }, { "type": "array", "minItems": 1, "maxItems": 7, "items": { "$ref": "#/$defs/type_name" } } ] },
    "ref": { "type": "string", "pattern": "^#/\\$defs/[A-Za-z][A-Za-z0-9_]{0,63}$" },
    "scalar": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "$ref": "#/$defs/type_spec" },
        "enum": { "type": "array", "minItems": 1, "maxItems": 64 },
        "const": true,
        "format": { "enum": ["date", "date-time"] },
        "pattern": { "type": "string", "minLength": 1, "maxLength": 400 },
        "minLength": { "type": "integer", "minimum": 0 },
        "maxLength": { "type": "integer", "minimum": 0 },
        "minimum": { "type": "number" },
        "maximum": { "type": "number" },
        "title": { "type": "string", "maxLength": 120 },
        "description": { "type": "string", "maxLength": 1000 },
        "$comment": { "type": "string", "maxLength": 1000 },
        "default": true,
        "examples": { "type": "array", "maxItems": 16 },
        "deprecated": { "type": "boolean" },
        "readOnly": { "type": "boolean" },
        "writeOnly": { "type": "boolean" },
        "$ref": { "$ref": "#/$defs/ref" }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "$ref": "#/$defs/type_spec" },
        "enum": { "type": "array", "minItems": 1, "maxItems": 64 },
        "const": true,
        "format": { "enum": ["date", "date-time"] },
        "pattern": { "type": "string", "minLength": 1, "maxLength": 400 },
        "minLength": { "type": "integer", "minimum": 0 },
        "maxLength": { "type": "integer", "minimum": 0 },
        "minimum": { "type": "number" },
        "maximum": { "type": "number" },
        "minItems": { "type": "integer", "minimum": 0 },
        "maxItems": { "type": "integer", "minimum": 0 },
        "maxProperties": { "type": "integer", "minimum": 0 },
        "items": { "$ref": "#/$defs/scalar" },
        "required": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/field_name" } },
        "properties": { "type": "object", "maxProperties": 64, "additionalProperties": false, "patternProperties": { "^[a-z][a-z0-9_]{0,63}$": { "$ref": "#/$defs/scalar" } } },
        "additionalProperties": { "const": false },
        "title": { "type": "string", "maxLength": 120 },
        "description": { "type": "string", "maxLength": 1000 },
        "$comment": { "type": "string", "maxLength": 1000 },
        "default": true,
        "examples": { "type": "array", "maxItems": 16 },
        "deprecated": { "type": "boolean" },
        "readOnly": { "type": "boolean" },
        "writeOnly": { "type": "boolean" },
        "$ref": { "$ref": "#/$defs/ref" }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "$ref": "#/$defs/type_spec" },
        "enum": { "type": "array", "minItems": 1, "maxItems": 64 },
        "const": true,
        "format": { "enum": ["date", "date-time"] },
        "pattern": { "type": "string", "minLength": 1, "maxLength": 400 },
        "minLength": { "type": "integer", "minimum": 0 },
        "maxLength": { "type": "integer", "minimum": 0 },
        "minimum": { "type": "number" },
        "maximum": { "type": "number" },
        "minItems": { "type": "integer", "minimum": 0 },
        "maxItems": { "type": "integer", "minimum": 0 },
        "maxProperties": { "type": "integer", "minimum": 0 },
        "items": { "$ref": "#/$defs/item" },
        "required": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/field_name" } },
        "properties": { "type": "object", "maxProperties": 64, "additionalProperties": false, "patternProperties": { "^[a-z][a-z0-9_]{0,63}$": { "$ref": "#/$defs/item" } } },
        "additionalProperties": { "const": false },
        "oneOf": { "type": "array", "minItems": 2, "maxItems": 8, "items": { "$ref": "#/$defs/item" } },
        "title": { "type": "string", "maxLength": 120 },
        "description": { "type": "string", "maxLength": 1000 },
        "$comment": { "type": "string", "maxLength": 1000 },
        "default": true,
        "examples": { "type": "array", "maxItems": 16 },
        "deprecated": { "type": "boolean" },
        "readOnly": { "type": "boolean" },
        "writeOnly": { "type": "boolean" },
        "$ref": { "$ref": "#/$defs/ref" }
      }
    }
  }
}
