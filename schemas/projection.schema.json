{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dotfield.projection/1",
  "title": "Dotfield projection",
  "description": "The signed envelope one center hands to one person (VISION 7.2), written by lib/share.mjs emitProjection() under data/projections/out/ and read by lib/overlay.mjs importProjection(). receiver is always one person (a circle rule emits one file per member). Every overlay id is namespaced person-<grantor>-... . digest = sha256(canonical(projection minus digest and signature)); signature.sig is ed25519 over canonical(projection minus signature), so a file for one receiver cannot be replayed to another. Caps: label 120, sublabel 200, string values 1 KB; control characters and fence sequences are stripped on import. Open maps: overlay.nodes[*].fields.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "projection_id", "grantor_person_id", "receiver", "rule_refs", "switches", "released_on", "expires_on", "revoked_rule_refs", "overlay", "digest", "signature", "receipt_id"],
  "properties": {
    "schema_version": { "const": "dotfield.projection/1" },
    "projection_id": { "type": "string", "pattern": "^proj-[a-z0-9][a-z0-9_.:-]{0,118}$" },
    "grantor_person_id": { "$ref": "#/$defs/id" },
    "receiver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": { "enum": ["person"] },
        "id": { "$ref": "#/$defs/id" }
      }
    },
    "rule_refs": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "$ref": "#/$defs/rule_ref" } },
    "switches": {
      "type": "object",
      "additionalProperties": false,
      "required": ["view", "annotate", "re_share", "aggregate", "train"],
      "properties": {
        "view": { "type": "boolean" },
        "annotate": { "type": "boolean" },
        "re_share": { "type": "boolean" },
        "aggregate": { "type": "boolean" },
        "train": { "type": "boolean" }
      }
    },
    "released_on": { "$ref": "#/$defs/date" },
    "expires_on": { "type": ["string", "null"], "format": "date" },
    "revoked_rule_refs": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/rule_ref" } },
    "overlay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "groups", "nodes", "edges"],
      "properties": {
        "id": { "type": "string", "pattern": "^person-[a-z0-9][a-z0-9_.:-]{0,72}$" },
        "groups": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/group" } },
        "nodes": { "type": "array", "maxItems": 2000, "items": { "$ref": "#/$defs/node" } },
        "edges": { "type": "array", "maxItems": 4000, "items": { "$ref": "#/$defs/edge" } }
      }
    },
    "digest": { "$ref": "#/$defs/digest" },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alg", "key_id", "signed", "sig"],
      "properties": {
        "alg": { "const": "ed25519" },
        "key_id": { "$ref": "#/$defs/id" },
        "signed": { "const": "canonical(projection minus signature)" },
        "sig": { "type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$", "description": "64 signature bytes in standard base64." }
      }
    },
    "receipt_id": { "type": "string", "pattern": "^rcpt_[0-9]{8}T[0-9]{6}Z_[0-9a-f]{4}$" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.:-]{0,79}$" },
    "namespaced_id": { "type": "string", "pattern": "^person-[a-z0-9][a-z0-9_.:-]{0,72}$" },
    "rule_ref": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.:-]*/[a-z0-9][a-z0-9_.:-]*$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "date": { "type": "string", "format": "date" },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "kind"],
      "properties": {
        "id": { "$ref": "#/$defs/namespaced_id" },
        "label": { "type": "string", "minLength": 1, "maxLength": 120 },
        "kind": { "enum": ["discipline", "circle", "person", "region"] }
      }
    },
    "node": {
      "description": "Exactly fields_allowed plus the fixed metadata set: kind, namespaced id, label (the stub <room> · <6 hex> unless label_field is allowed), sublabel and tags only when their source field is allowed, provenance with rule_ref and released_on, audience, and the boundary block with the salted projected-subset digest, dates and key_id.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "label", "tags", "fields", "provenance", "audience", "boundary"],
      "properties": {
        "id": { "$ref": "#/$defs/namespaced_id" },
        "kind": { "const": "boundary" },
        "label": { "type": "string", "minLength": 1, "maxLength": 120 },
        "sublabel": { "type": "string", "maxLength": 200 },
        "group": { "$ref": "#/$defs/namespaced_id" },
        "tags": { "type": "array", "maxItems": 32, "items": { "type": "string", "minLength": 1, "maxLength": 40 } },
        "fields": {
          "type": "object",
          "maxProperties": 32,
          "additionalProperties": {
            "type": ["string", "number", "boolean", "null", "array"],
            "maxLength": 1024,
            "maxItems": 64,
            "items": { "type": ["string", "number", "boolean", "null"], "maxLength": 1024 }
          }
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["owner_person_id", "source", "captured_on", "released_on", "imported_via_rule_ref"],
          "properties": {
            "owner_person_id": { "$ref": "#/$defs/id" },
            "source": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "ref", "digest"],
              "properties": {
                "kind": { "const": "share" },
                "ref": { "type": "string", "minLength": 1, "maxLength": 512 },
                "digest": { "$ref": "#/$defs/digest" }
              }
            },
            "captured_on": { "$ref": "#/$defs/date" },
            "happened_on": { "$ref": "#/$defs/date" },
            "remembered_on": { "$ref": "#/$defs/date" },
            "released_on": { "$ref": "#/$defs/date" },
            "imported_via_rule_ref": { "$ref": "#/$defs/rule_ref" }
          }
        },
        "audience": {
          "type": "object",
          "additionalProperties": false,
          "required": ["privacy_level", "share_rule_ids"],
          "properties": {
            "privacy_level": { "enum": ["public", "private", "sensitive"] },
            "share_rule_ids": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "$ref": "#/$defs/id" } }
          }
        },
        "boundary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rule_ref", "digest", "shared_by", "released_on", "key_id"],
          "properties": {
            "rule_ref": { "$ref": "#/$defs/rule_ref" },
            "digest": { "$ref": "#/$defs/digest" },
            "shared_by": { "$ref": "#/$defs/id" },
            "released_on": { "$ref": "#/$defs/date" },
            "expires_on": { "$ref": "#/$defs/date" },
            "key_id": { "$ref": "#/$defs/id" }
          }
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from", "to", "kind", "directed"],
      "properties": {
        "id": { "$ref": "#/$defs/namespaced_id" },
        "from": { "$ref": "#/$defs/id" },
        "to": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["relates", "link", "cites", "influences", "depends", "member", "contains", "precedes", "flow", "annotates"] },
        "directed": { "type": "boolean" },
        "label": { "type": "string", "maxLength": 120 },
        "weight": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
