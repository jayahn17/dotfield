{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dotfield.room/1",
  "title": "Dotfield room manifest",
  "description": "center/rooms/<id>/room.json (VISION 5). Closed except ext. mode is read_only | proposal_only | blocked (write_after_approval is removed; lib/rooms.mjs reports DF_ROOM_MODE_DEPRECATED and treats it as proposal_only). owner_gates.writes and owner_gates.share can only be 'required': no mode exists without the owner gate. proof is {test, expected[]}; a proof.command key is DF_ROOM_PROOF_COMMAND_FORBIDDEN. $defs.views_file is the grammar of views.json, validated by lib/rooms.mjs under DF_ROOM_VIEW_INVALID.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "label", "purpose", "mode", "privacy_mode", "maturity", "store", "record", "views", "desks", "owner_gates", "blocked_actions", "proof", "done_definition"],
  "properties": {
    "$schema": { "type": "string", "maxLength": 200 },
    "schema_version": { "const": "dotfield.room/1" },
    "id": { "$ref": "#/$defs/room_id" },
    "label": { "type": "string", "minLength": 1, "maxLength": 80 },
    "icon": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,39}$" },
    "pack": { "type": ["string", "null"], "pattern": "^[a-z][a-z0-9-]{0,39}$" },
    "purpose": { "type": "string", "minLength": 1, "maxLength": 400 },
    "mode": { "enum": ["read_only", "proposal_only", "blocked"] },
    "privacy_mode": { "enum": ["private_live", "synthetic_data", "public_demo"] },
    "maturity": { "$ref": "#/$defs/maturity" },
    "store": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "namespace"],
      "properties": {
        "scope": { "enum": ["owner", "person"], "description": "owner: one file data/rooms/<namespace>.json; person: sharded per viewer under data/person_<id>/rooms/." },
        "namespace": { "$ref": "#/$defs/room_id", "description": "The store file name; two rooms never share one (DF_ROOM_NAMESPACE_SHARED)." },
        "max_records": { "type": "integer", "minimum": 1, "maximum": 100000, "default": 2000 },
        "max_record_bytes": { "type": "integer", "minimum": 256, "maximum": 1048576, "default": 16384 }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "id_field", "label_field", "default_privacy_level", "public_fields"],
      "properties": {
        "schema": { "const": "record.schema.json" },
        "id_field": { "$ref": "#/$defs/field" },
        "label_field": { "$ref": "#/$defs/field" },
        "sublabel_field": { "$ref": "#/$defs/field" },
        "tag_field": { "$ref": "#/$defs/field" },
        "weight_field": { "$ref": "#/$defs/field" },
        "dates": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "happened_on": { "$ref": "#/$defs/field" },
            "remembered_on": { "$ref": "#/$defs/field" },
            "released_on": { "$ref": "#/$defs/field" }
          }
        },
        "link_fields": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["field", "to_room", "kind"],
            "properties": {
              "field": { "$ref": "#/$defs/field" },
              "to_room": { "$ref": "#/$defs/room_id" },
              "kind": { "enum": ["relates", "link", "cites", "influences", "depends", "member", "contains", "precedes", "flow"] }
            }
          }
        },
        "default_privacy_level": { "$ref": "#/$defs/privacy_level" },
        "public_fields": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/field" }, "description": "The ceiling on every field, label, sublabel and tag any projection may carry. Empty means nothing leaves." }
      }
    },
    "views": { "const": "views.json" },
    "desks": { "type": "array", "maxItems": 12, "items": { "$ref": "#/$defs/desk" } },
    "owner_gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["writes", "external_sends", "share", "aggregate", "train"],
      "properties": {
        "writes": { "enum": ["required"] },
        "external_sends": { "enum": ["required", "blocked"] },
        "share": { "enum": ["required"] },
        "aggregate": { "enum": ["required", "blocked"] },
        "train": { "enum": ["required", "blocked"] }
      }
    },
    "blocked_actions": { "type": "array", "maxItems": 32, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,59}$" } },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["test", "expected"],
      "properties": {
        "test": { "type": "boolean", "description": "true when the room ships a test.mjs the sandbox runs." },
        "expected": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 200 } }
      }
    },
    "done_definition": { "type": "string", "minLength": 1, "maxLength": 400 },
    "ext": { "type": "object", "description": "Customer round-tripping only; never read by the engine." }
  },
  "$defs": {
    "room_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,39}$" },
    "field": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
    "maturity": { "enum": ["contract_only", "prototype", "local_beta", "tested"] },
    "privacy_level": { "enum": ["public", "private", "sensitive", "blocked"] },
    "color_token": { "type": "string", "pattern": "^(series-[1-6]|accent|accent-2|muted|good|warn|bad|foreign)$" },
    "path_expr": { "type": "string", "pattern": "^\\$(\\.[a-z][a-z0-9_]{0,63}(\\[(\\*|0|[1-9][0-9]{0,3})\\])?){1,6}(/[1-9][0-9]{0,5})?$", "description": "The views.json JSONPath subset: $.a.b, $.a[*], $.a[0], optional /n arithmetic." },
    "desk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "display", "tier", "domain", "primary_field", "lens", "keywords", "constraint"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,39}$" },
        "display": { "type": "string", "minLength": 1, "maxLength": 80 },
        "tier": { "enum": ["core", "support", "challenger"] },
        "domain": { "type": "string", "minLength": 1, "maxLength": 120 },
        "primary_field": { "type": "string", "minLength": 1, "maxLength": 120 },
        "adjacent_fields": { "type": "array", "maxItems": 8, "items": { "type": "string", "minLength": 1, "maxLength": 120 } },
        "lens": { "type": "string", "minLength": 1, "maxLength": 300 },
        "keywords": { "type": "array", "minItems": 1, "maxItems": 24, "items": { "type": "string", "minLength": 1, "maxLength": 40 } },
        "challenger_for": { "type": "array", "maxItems": 12, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,39}$" } },
        "influences": { "type": "array", "maxItems": 12, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,39}$" } },
        "constraint": { "type": "string", "minLength": 1, "maxLength": 300 },
        "prompt": { "type": ["string", "null"], "maxLength": 4000 }
      }
    },
    "views_file": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "$ref": "#/$defs/view" } },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "kind", "node"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,39}$" },
        "label": { "type": "string", "minLength": 1, "maxLength": 80 },
        "kind": { "enum": ["graph", "room", "timeline", "board", "workflow"] },
        "theme": { "enum": ["default", "light", "paper", "studio", "field", "story", "editorial", "blueprint"] },
        "node": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "label"],
          "properties": {
            "kind": { "type": "string", "pattern": "^(record|note|person|desk|tag|file|asset|event|place|idea|x-[a-z0-9-]{1,39})$" },
            "label": { "$ref": "#/$defs/path_expr" },
            "sublabel": { "$ref": "#/$defs/path_expr" },
            "tags": { "$ref": "#/$defs/path_expr" },
            "weight": { "$ref": "#/$defs/path_expr" },
            "color_token": { "$ref": "#/$defs/color_token" },
            "color_token_by": {
              "type": "object",
              "additionalProperties": false,
              "required": ["field", "map"],
              "properties": {
                "field": { "$ref": "#/$defs/path_expr" },
                "map": { "type": "object", "maxProperties": 32, "patternProperties": { "^.{1,64}$": { "$ref": "#/$defs/color_token" } }, "additionalProperties": false }
              }
            }
          }
        },
        "date": { "$ref": "#/$defs/path_expr", "description": "Required for kind timeline." },
        "lane": { "$ref": "#/$defs/path_expr", "description": "Required for kind board." },
        "pose": { "$ref": "#/$defs/path_expr", "description": "A field holding {xyz, rpy} for kind room." },
        "include_rooms": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/room_id" } },
        "group_by": {
          "type": "object",
          "additionalProperties": false,
          "required": ["field", "kind"],
          "properties": {
            "field": { "$ref": "#/$defs/path_expr" },
            "kind": { "enum": ["region", "discipline", "circle", "zone", "lane", "person"] }
          }
        },
        "limit": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_nodes", "default_lens"],
          "properties": {
            "max_nodes": { "type": "integer", "minimum": 1, "maximum": 2000 },
            "default_lens": { "type": ["string", "null"], "pattern": "^[a-z][a-z0-9-]{0,39}$" }
          }
        },
        "views_off": { "type": "array", "maxItems": 3, "items": { "enum": ["2d", "3d", "vr"] }, "description": "Views this room view disables; render refuses them with DF_RENDER_VIEW_DISABLED (same enum as pack.json views_off)." },
        "views": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "2d": { "type": "object", "additionalProperties": false, "properties": {
              "layout": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,39}$" },
              "seed": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
              "spacing": { "type": "number", "minimum": 0.1, "maximum": 10 },
              "viewBox": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "number" } } } },
            "3d": { "type": "object", "additionalProperties": false, "properties": {
              "layout": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,39}$" },
              "scale_m": { "type": "number", "minimum": 0.1, "maximum": 100 },
              "camera": { "type": "object", "additionalProperties": false, "properties": {
                "position": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } },
                "target": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } } } },
              "lift": { "type": "object", "additionalProperties": false, "required": ["mode", "amplitude_m"], "properties": {
                "mode": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,39}$" },
                "amplitude_m": { "type": "number", "minimum": 0, "maximum": 50 } } } } },
            "vr": { "type": "object", "additionalProperties": false, "required": ["enabled"], "properties": {
              "enabled": { "type": "boolean" },
              "scale_m": { "type": "number", "minimum": 0.1, "maximum": 100 },
              "floor_y": { "type": "number", "minimum": -10, "maximum": 10 },
              "eye_height_m": { "type": "number", "minimum": 0.5, "maximum": 2.5 },
              "entry_node": { "type": ["string", "null"], "maxLength": 80 },
              "label_budget": { "type": "integer", "minimum": 0, "maximum": 2000 } } }
          }
        },
        "lenses": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "match"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,39}$" },
              "label": { "type": "string", "minLength": 1, "maxLength": 80 },
              "match": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "tags": { "type": "array", "maxItems": 32, "items": { "type": "string", "minLength": 1, "maxLength": 64 } },
                  "groups": { "type": "array", "maxItems": 32, "items": { "type": "string", "minLength": 1, "maxLength": 80 } },
                  "owner": { "type": "array", "maxItems": 32, "items": { "type": "string", "minLength": 1, "maxLength": 80 } },
                  "kinds": { "type": "array", "maxItems": 16, "items": { "type": "string", "minLength": 1, "maxLength": 40 } },
                  "rooms": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/room_id" } }
                }
              }
            }
          }
        }
      }
    }
  }
}
